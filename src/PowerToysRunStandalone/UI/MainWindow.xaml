<Window x:Class="PowerToysRunStandalone.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerToys Run Standalone"
        Width="720" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated">

    <Grid>
        <Border x:Name="RootBorder"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="QueryBox"
                             FontSize="20"
                             Padding="10,8"
                             Background="{StaticResource InputBackgroundBrush}"
                             Foreground="{StaticResource ForegroundBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource ForegroundBrush}"
                             TextChanged="QueryBox_TextChanged"
                             KeyDown="QueryBox_KeyDown" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button x:Name="SettingsButton"
                                Content="⚙"
                                FontSize="18"
                                Width="40" Height="40"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryForegroundBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SettingsButton_Click"
                                ToolTip="Settings" />
                        <Button x:Name="CloseButton"
                                Content="✕"
                                FontSize="16"
                                Width="36" Height="40"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryForegroundBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                ToolTip="Hide to tray (right-click tray icon to exit)" />
                    </StackPanel>
                </Grid>

                <!-- Results -->
                <ListBox x:Name="ResultList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource ForegroundBrush}"
                         ItemContainerStyle="{StaticResource ResultListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseDown="ResultList_PreviewMouseDown"
                         MouseLeftButtonUp="ResultList_MouseLeftButtonUp"
                         PreviewMouseRightButtonUp="ResultList_PreviewMouseRightButtonUp"
                         KeyDown="ResultList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Icon}"
                                           FontSize="24"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource SecondaryForegroundBrush}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding PluginName}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status bar -->
                <DockPanel Grid.Row="2" Margin="4,8,4,0">
                    <TextBlock x:Name="StatusText"
                               DockPanel.Dock="Left"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryForegroundBrush}" />
                    <TextBlock Text="Enter 执行 · Esc 隐藏 · ↑↓ 选择"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               TextAlignment="Right" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
