<Window x:Class="PowerToysRunStandalone.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerToys Run Standalone — Settings"
        Width="560" Height="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hotkey -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Global hotkey" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="HotkeyBox" Padding="8,6" FontSize="15" />
        </StackPanel>

        <!-- Startup behavior -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Startup behavior" FontWeight="SemiBold" Margin="0,0,0,4" />
            <CheckBox x:Name="AutoStartCheck" Content="Start with Windows" Margin="0,0,0,6" />
            <CheckBox x:Name="ShowOnStartupCheck" Content="Show the launcher window when the app starts" />
        </StackPanel>

        <!-- Web search -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Web search engine" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="SearchEngineCombo" Padding="6" FontSize="15" />
        </StackPanel>

        <!-- NTFS index -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="NTFS 文件索引 ($MFT)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <CheckBox x:Name="NtfsIndexCheck" Content="启用全盘文件搜索 (fs / ?) — 直接重建 NTFS MFT 记录" Margin="0,0,0,6" />
            <CheckBox x:Name="NtfsLiveSearchCheck" Content="索引外实时搜索（新建/未入索引文件，限时扫描）" Margin="0,0,0,6" />
            <CheckBox x:Name="PlainTextSearchCheck" Content="无前缀直接搜索全盘文件（类似 Everything，无需 fs / ?）" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="实时搜索时限" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="LiveTimeoutBox" Width="70" Padding="4,3" Text="800" />
                <TextBlock Text="ms (300–5000)" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="NtfsStatusText" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,0,0,6" />
            <Button x:Name="RebuildIndexButton" Content="立即重建索引" Padding="10,4" Click="RebuildIndex_Click" />
        </StackPanel>

        <!-- Plugins -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Plugins" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Border Background="#FFF0F0F2" BorderBrush="#FFD8D8DC" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,4,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PluginPanel" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="96" Height="34" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Save" Width="96" Height="34" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
