#include <windows.h>
#include "resource.h"

IDI_APP ICON "hotspot.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "hotspot (extracted from microsoft/PowerToys, MIT)"
            VALUE "FileDescription", "hotspot - Everything-style NTFS file search launcher (C++/Win32)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "LegalCopyright", "MIT License (c) Microsoft Corporation; reuse per PowerToys license"
            VALUE "ProductName", "hotspot"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
